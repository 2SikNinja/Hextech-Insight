{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sfo1"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "excludeFiles": "{.next,node_modules,src,public,tests,supabase}/**"
    }
  },
  "schedules": {
    "daily-maintenance": {
      "schedule": "23 10 * * *",
      "path": "/cron/daily",
      "requestMethod": "GET"
    }
  }
}
